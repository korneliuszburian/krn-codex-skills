{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Bash|apply_patch)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CODEX_HOME:-$HOME/.codex}/hooks/krn_pretooluse.py\"",
            "timeout": 10,
            "statusMessage": "Applying global command safety policy"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CODEX_HOME:-$HOME/.codex}/hooks/krn_precompact.py\"",
            "timeout": 10,
            "statusMessage": "KRN: persisting the memory layer before compaction"
          }
        ]
      }
    ]
  }
}

{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "result_version",
    "campaign_id",
    "shard_id",
    "status",
    "scope_summary",
    "source_coverage",
    "findings",
    "evidence_gaps",
    "human_decisions",
    "does_not_prove"
  ],
  "properties": {
    "result_version": {
      "type": "string",
      "enum": ["1"]
    },
    "campaign_id": {
      "type": "string",
      "minLength": 1
    },
    "shard_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": ["complete", "partial", "blocked"]
    },
    "scope_summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "source_coverage": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "status", "evidence_summary"],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": ["used", "unavailable", "omitted"]
          },
          "evidence_summary": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "citations",
          "mechanism",
          "conditions_and_traps",
          "implication",
          "candidate_disposition",
          "consumer",
          "example",
          "falsifier",
          "does_not_prove"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "citations": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["source_id", "locator", "detail"],
              "properties": {
                "source_id": {
                  "type": "string",
                  "minLength": 1
                },
                "locator": {
                  "type": "string",
                  "minLength": 1
                },
                "detail": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "mechanism": {
            "type": "string",
            "minLength": 1
          },
          "conditions_and_traps": {
            "type": "string",
            "minLength": 1
          },
          "implication": {
            "type": "string",
            "minLength": 1
          },
          "candidate_disposition": {
            "enum": ["adopt", "reject", "lab_test", "defer"]
          },
          "consumer": {
            "type": "string",
            "minLength": 1
          },
          "example": {
            "type": "string",
            "minLength": 1
          },
          "falsifier": {
            "type": "string",
            "minLength": 1
          },
          "does_not_prove": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "evidence_gaps": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["what", "requested_proof"],
        "properties": {
          "what": {
            "type": "string",
            "minLength": 1
          },
          "requested_proof": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "human_decisions": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["choice", "why_human"],
        "properties": {
          "choice": {
            "type": "string",
            "minLength": 1
          },
          "why_human": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "does_not_prove": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}

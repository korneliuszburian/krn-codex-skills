{
  "font": {
    "weight": {
      "$type": "fontWeight",
      "$description": "Helper classes and custom properties for common font weights.",
      "regular": {
        "$value": 400,
        "$extensions": {
          "pl.rekurencja.acf": { "label": "Regular (400)", "contexts": ["font-weight"] }
        }
      },
      "medium": {
        "$value": 500,
        "$extensions": {
          "pl.rekurencja.acf": { "label": "Medium (500)", "contexts": ["font-weight"] }
        }
      },
      "bold": {
        "$value": 700,
        "$extensions": {
          "pl.rekurencja.acf": { "label": "Bold (700)", "contexts": ["font-weight"] }
        }
      }
    }
  }
}

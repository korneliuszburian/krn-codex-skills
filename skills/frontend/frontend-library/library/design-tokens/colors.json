{
  "color": {
    "$type": "color",
    "$description": "Hex color codes that can be shared, cross-platform. They can be converted at point of usage, such as HSL for web or CMYK for print.",
    "dark": {
      "$value": "#030303",
      "$extensions": {
        "pl.rekurencja.acf": { "label": "Dark", "contexts": ["heading-color", "content-color", "eyebrow-color"] }
      }
    },
    "light": {
      "$value": "#ffffff",
      "$extensions": {
        "pl.rekurencja.acf": { "label": "Light", "contexts": ["heading-color", "content-color", "eyebrow-color"] }
      }
    },
    "surface": {
      "$value": "#f4f1ea"
    },
    "muted": {
      "$value": "#6f6a61",
      "$extensions": {
        "pl.rekurencja.acf": { "label": "Muted", "contexts": ["content-color", "eyebrow-color"] }
      }
    },
    "primary": {
      "$value": "#8D49B0",
      "$extensions": {
        "pl.rekurencja.acf": { "label": "Primary", "contexts": ["heading-color", "content-color", "eyebrow-color"] }
      }
    },
    "accent": {
      "$value": "#faff00",
      "$extensions": {
        "pl.rekurencja.acf": { "label": "Accent", "contexts": ["heading-color", "eyebrow-color"] }
      }
    },
    "focus": {
      "$value": "{color.primary}"
    },
    "bg": {
      "$value": "{color.light}"
    },
    "text": {
      "$value": "{color.dark}",
      "$extensions": {
        "pl.rekurencja.acf": { "label": "Default text", "contexts": ["heading-color", "content-color", "eyebrow-color"] }
      }
    },
    "selection": {
      "bg": {
        "$value": "{color.dark}"
      },
      "text": {
        "$value": "{color.light}"
      }
    }
  }
}

{
  "leading": {
    "$type": "number",
    "$description": "Ratio-based leading/line-height values.",
    "flat": { "$value": 1 },
    "fine": { "$value": 1.15 },
    "compact": {
      "$value": 1.3,
      "$extensions": {
        "pl.rekurencja.acf": { "label": "Compact (130%)", "contexts": ["heading-leading", "content-leading", "eyebrow-leading"] }
      }
    },
    "standard": { "$value": 1.5 },
    "loose": { "$value": 1.7 }
  }
}

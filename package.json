{
  "name": "@krn/agent-skills",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "krn-codex": "scripts/krn-codex.mjs",
    "krn-codex-catalog": "scripts/krn-codex-catalog.mjs"
  },
  "scripts": {
    "catalog": "node scripts/catalog.mjs",
    "test:bootstrap": "node --test test/bootstrap-fixture/bootstrap.test.mjs",
    "test:hooks": "python3 -B -m unittest scripts/hooks/test_destructive_guard.py",
    "test:install": "node --test test/install-smoke.test.mjs test/install-classify.test.mjs",
    "test:state": "node --test test/state-check.test.mjs test/state-brief.test.mjs test/composition.test.mjs test/capsule-abi.test.mjs",
    "test:skills": "node --test test/skills-export.test.mjs",
    "skills:check": "node scripts/krn-codex.mjs skills check --root .",
    "lessons:check": "node scripts/krn-codex.mjs lessons check --root .",
    "test:lessons": "node --test test/lessons.test.mjs",
    "test:validate": "node --test test/durable-pages.test.mjs",
    "validate": "node scripts/validate.mjs",
    "install:check": "bash scripts/install.sh check"
  }
}

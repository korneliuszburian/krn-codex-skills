{
  "name": "@krn/agent-skills",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "krn-codex-catalog": "scripts/catalog.mjs"
  },
  "scripts": {
    "catalog": "node scripts/catalog.mjs",
    "test:catalog": "node --test scripts/catalog*.test.mjs",
    "test:install": "node --test scripts/install.test.mjs",
    "test:hooks": "python3 -B -m unittest scripts/hooks/test_destructive_guard.py",
    "test:validate-review": "python3 -B skills/advisory/second-opinion-review/scripts/test_validate_review.py",
    "test:second-opinion": "node --test skills/advisory/second-opinion-review/scripts/*.test.mjs && node skills/advisory/second-opinion-review/scripts/check-claude-window.mjs self-test",
    "validate": "node scripts/validate.mjs",
    "install:check": "bash scripts/install.sh check"
  }
}

{
  "workspaceRoot": ".",
  "outputDir": ".artifacts",
  "sessionPrefix": "krn-frontend-fixture",
  "url": "http://127.0.0.1:4173/",
  "allowedOrigins": [
    "http://127.0.0.1:4173"
  ],
  "viewport": {
    "width": 960,
    "height": 720
  },
  "build": {
    "command": "node",
    "args": [
      "build.mjs"
    ],
    "cwd": ".",
    "outputRoot": "dist"
  },
  "runtime": {
    "command": "node",
    "args": [
      "serve.mjs"
    ],
    "cwd": ".",
    "readyUrl": "http://127.0.0.1:4173/",
    "timeoutMs": 10000
  },
  "evidence": {
    "required": [
      "screenshot",
      "snapshot",
      "runtime",
      "console",
      "network",
      "interaction",
      "cleanup"
    ]
  },
  "actions": [
    {
      "kind": "click",
      "role": "button",
      "text": "Complete task"
    }
  ],
  "runtimeEval": "JSON.stringify({url: location.href, status: document.querySelector('[data-testid=task-status]').textContent, state: document.querySelector('[data-testid=task-status]').dataset.state, rect: document.querySelector('[data-testid=task-card]').getBoundingClientRect().toJSON()})"
}
